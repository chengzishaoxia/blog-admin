# 应用端口
VITE_APP_PORT=3000
# 项目名称
VITE_APP_TITLE=klee-blog
# 代理前缀
VITE_APP_BASE_API=/api

# 接口地址
VITE_APP_API_URL=http://localhost:8989    # 本地

# WebSocket 端点（不配置则关闭）
VITE_APP_WS_ENDPOINT=ws://localhost:18080/ws/admin

# 启用 Mock 服务
VITE_MOCK_DEV_SERVER=false

# 指定 satoken cookie 名称
VITE_APP_TOKEN_COOKIE_NAME=satoken
